  speechList:
  - entity: 1
    speechText: You must be the nefor my little girl has been talking about, is that
      right?
    wantedIndex: 0
    buttons: []
  - entity: 0
    speechText: ...
    wantedIndex: 0
    buttons:
    - choiceAttitude: -1
      leadTalk: {fileID: 0}
      buttonText: Hello, y-yes, n-nice to meet you.
    - choiceAttitude: -3
      leadTalk: {fileID: 11400000, guid: 88c5ba17c4ac6364d85080ce18be90a8, type: 2}
      buttonText: Well, yeah, and you're the dude who summons a tsunami with every
        fart, right?
    - choiceAttitude: 2
      leadTalk: {fileID: 0}
      buttonText: Yes, my name is Artyom, it's a pleasure to meet you.
  - entity: 1
    speechText: ' I have just one simple task for you to win my daughter. You just
      have to survive.'
    wantedIndex: 0
    buttons: []
  - entity: 0
    speechText: WHAT?!
    wantedIndex: 0
    buttons: []
  - entity: 1
    speechText: You will face three trials. In each one, you just need to last for
      a single minute.
    wantedIndex: 0
    buttons: []
  - entity: 1
    speechText: I belive everything is clear... Artyom?
    wantedIndex: 0
    buttons: []
  - entity: 2
    speechText: Don't be scared, you can do it!
    wantedIndex: 0
    buttons: []
  - entity: 2
    speechText: Here, a little gift from me. (A shield)
    wantedIndex: 0
    buttons: []
  - entity: 0
    speechText: B-b-bb-but
    wantedIndex: 0
    buttons: []
