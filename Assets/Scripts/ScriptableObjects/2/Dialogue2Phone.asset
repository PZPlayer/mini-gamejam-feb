MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4e73ae3b6ccd51b4e8d65398b1f8d3ca, type: 3}
  m_Name: Dialogue2Phone
  m_EditorClassIdentifier: Assembly-CSharp::Jam.Talking.Talk
  speechList:
  - entity: 3
    speechText: Try to get on my father's good side.
    wantedIndex: 0
    buttons: []
  - entity: 3
    speechText: The better your relationship with him, the easier it will be for
      you to parry.
    wantedIndex: 0
    buttons: []
  - entity: 3
    speechText: The worse it is, the harder it gets.
    wantedIndex: 0
    buttons: []
  - entity: 3
    speechText: I thiiiiink...
    wantedIndex: 0
    buttons: []
  - entity: 3
    speechText: My father likes fish.
    wantedIndex: 0
    buttons: []
  - entity: 0
    speechText: Eghhh, Sir...
    wantedIndex: 0
    buttons:
    - choiceAttitude: -2
      leadTalk: {fileID: 11400000, guid: 7704db9491faf34448cef1ba53798c95, type: 2}
      buttonText: Tell him about fishing.
    - choiceAttitude: 2
      leadTalk: {fileID: 11400000, guid: ef40420063774d84b925552dc03c92d4, type: 2}
      buttonText: Tell him about your pet fish.
    - choiceAttitude: -4
      leadTalk: {fileID: 11400000, guid: b6a00da83c7b1ec4eb3cfd50cd63515e, type: 2}
      buttonText: Tell him you find fish... attractive.
  - entity: 3
    speechText: He also likes to play soccer
    wantedIndex: 0
    buttons: []
  - entity: 0
    speechText: Sir...
    wantedIndex: 0
    buttons:
    - choiceAttitude: -2
      leadTalk: {fileID: 11400000, guid: b082ab1cb4d650649b4bebd67e2496db, type: 2}
      buttonText: Suggest playing some ball.
    - choiceAttitude: -2
      leadTalk: {fileID: 11400000, guid: b082ab1cb4d650649b4bebd67e2496db, type: 2}
      buttonText: Suggest a juggling competition.
    - choiceAttitude: 2
      leadTalk: {fileID: 11400000, guid: 18b7b7ed7c44b2146b62dffbeaf069c6, type: 2}
      buttonText: Say you love cheering for Real Madrid.
  - entity: 3
    speechText: Oops, sorry!) I don't really know, I mostly ignore him.
    wantedIndex: 0
    buttons: []
  - entity: 1
    speechText: Time for the next trial!
    wantedIndex: 0
    buttons: []
